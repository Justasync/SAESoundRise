# Beta site protection: skip auth for non-beta hosts
SetEnvIf Host .* SKIP_AUTH
SetEnvIfNoCase Host "beta" !SKIP_AUTH

AuthType Basic
AuthName "Veuillez vous identifier pour accéder au site de test"
AuthUserFile /home/u488841025/domains/beta.paaxio.com/public_html/config/.htpasswd
Require valid-user
Satisfy Any
Order Deny,Allow
Deny from all
Allow from env=SKIP_AUTH

<IfModule mod_php.c>
    php_value upload_max_filesize 25M
    php_value post_max_size 300M
    php_value memory_limit 350M
    php_value max_execution_time 300
</IfModule>

# Disable directory listing
Options -Indexes

RewriteEngine On

RewriteRule ^archive/ - [F,L]
RewriteRule ^config/ - [F,L]
RewriteRule ^sql/ - [F,L]
RewriteRule ^scripts/logs/ - [F,L]
RewriteRule ^backups/ - [F,L]

# Deny access to sensitive files
<FilesMatch "\.(htaccess|htpasswd|env|ini|log|sh|p8|pem|key|crt|gitignore|gitmodules|lock|sql|bak|gz|tar|zip|dump)$">
  Require all denied
</FilesMatch>