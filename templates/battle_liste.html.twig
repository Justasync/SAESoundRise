{% extends 'base_template.html.twig' %}

{% block content %}
<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-secondary">Arène des Battles</h2>
        {# Le bouton de création reste visible pour les artistes #}
        {% if session.user_role == 'artiste' %}
            <button class="btn btn-lg text-white shadow-sm" style="background-color: #E58E82; border-radius: 15px;" onclick="ouvrirModalSelection()">
                <i class="bi bi-plus-circle me-2"></i>Créer une battle
            </button>
        {% endif %}
    </div>

    <div class="row justify-content-center" id="liste-battles">
        {% if battles is empty %}
            <div class="col-md-8 text-center p-5 rounded-4" style="background-color: #f8f9fa; border: 2px dashed #dee2e6;">
                <p class="text-muted fs-5">Il n'y a aucun combat en cours pour le moment.</p>
            </div>
        {% else %}
            {% for battle in battles %}
                <div class="col-md-8 mb-4">
                    <div class="p-4 rounded-4 shadow-sm" style="background-color: #F8D7D2; border: 1px solid #E58E82;">
                        {# NETTOYAGE DU TITRE : On enlève "Battle :" #}
                        <h4 class="text-center text-white mb-4 fw-bold">{{ battle.getTitreBattle()|replace({'Battle : ': ''}) }}</h4>
                        
                        <div class="d-flex justify-content-around align-items-center">
                            <div class="text-center">
                                <div class="rounded-4 bg-white p-2 shadow-sm">
                                    <img src="{{ battle.getCreateur().geturlPhotoUtilisateur() ?? 'assets/images/default-avatar.png' }}" class="rounded-4" style="width:150px; height:150px; object-fit:cover;">
                                </div>
                                <p class="mt-2 fw-bold text-secondary">{{ battle.getCreateur().getPseudoUtilisateur() }}</p>
                            </div>

                            <div class="vs-badge"><span class="badge rounded-pill bg-white text-danger fs-3 px-4 shadow-sm">VS</span></div>

                            <div class="text-center">
                                <div class="rounded-4 bg-white p-2 shadow-sm">
                                    <img src="{{ battle.getParticipant().geturlPhotoUtilisateur() ?? 'assets/images/default-avatar.png' }}" class="rounded-4" style="width:150px; height:150px; object-fit:cover;">
                                </div>
                                <p class="mt-2 fw-bold text-secondary">{{ battle.getParticipant().getPseudoUtilisateur() }}</p>
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <span class="badge bg-success px-4 py-2 fs-6 shadow-sm">
                                <i class="bi bi-fire me-2"></i>COMBAT EN COURS
                            </span>
                            {# Les boutons de vote seront ajoutés ici #}
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

{% include 'modales_battle.html.twig' %}
{% endblock %}