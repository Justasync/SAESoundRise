{% extends 'base_template.html.twig' %}

{% block content %}
<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-secondary">Arène des Battles</h2>
        <button class="btn btn-lg text-white shadow-sm" style="background-color: #E58E82; border-radius: 15px;" onclick="ouvrirModalSelection()">
            <i class="bi bi-plus-circle me-2"></i>Créer une battle
        </button>
    </div>

    <div class="row justify-content-center" id="liste-battles">
        {% if battles is empty %}
            <div class="col-md-8 text-center p-5 rounded-4" style="background-color: #f8f9fa; border: 2px dashed #dee2e6;">
                <p class="text-muted fs-5">Il n'y a aucune battle pour le moment. Soyez le premier à en lancer une !</p>
            </div>
        {% else %}
            {% for battle in battles %}
                <div class="col-md-8 mb-4">
                    <div class="p-4 rounded-4 shadow-sm" style="background-color: #F8D7D2; border: 1px solid #E58E82;">
                        <h4 class="text-center text-white mb-4 fw-bold">{{ battle.getTitreBattle() }}</h4>
                        
                        <div class="d-flex justify-content-around align-items-center">
                            <!-- Créateur -->
                            <div class="text-center">
                                <div class="rounded-4 bg-white p-2 shadow-sm">
                                    <img src="assets/images/{{ battle.getEmailCreateurBattle() }}.jpg" class="rounded-4" style="width:150px; height:150px; object-fit:cover;">
                                </div>
                                <p class="mt-2 fw-bold text-secondary">{{ battle.getEmailCreateurBattle() }}</p>
                            </div>

                            <div class="vs-badge">
                                <span class="badge rounded-pill bg-white text-danger fs-3 px-4 shadow-sm">VS</span>
                            </div>

                            <!-- Participant -->
                            <div class="text-center">
                                {% if battle.getEmailParticipantBattle() %}
                                    <div class="rounded-4 bg-white p-2 shadow-sm">
                                        <img src="assets/images/{{ battle.getEmailParticipantBattle() }}.jpg" class="rounded-4" style="width:150px; height:150px; object-fit:cover;">
                                    </div>
                                    <p class="mt-2 fw-bold text-secondary">{{ battle.getEmailParticipantBattle() }}</p>
                                {% else %}
                                    <div class="rounded-4 bg-light d-flex align-items-center justify-content-center shadow-inner" style="width:150px; height:150px; border: 2px dashed #E58E82;">
                                        <p class="text-muted small m-0">En attente...</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        <!-- Actions de la Battle -->
                        <div class="text-center mt-4">
                            {% set estCreateur = (battle.getEmailCreateurBattle() == session.user_email) %}
                            {% set estInvite = (battle.getEmailParticipantBattle() == session.user_email) %}

                            {% if battle.getStatutBattle().value == 'en_attente' %}
                                {% if estCreateur and not battle.getIdChansonCreateur() %}
                                    <button class="btn btn-sm text-white px-4" style="background-color: #E58E82;" onclick="ouvrirModalChanson('{{ battle.getIdBattle() }}')">
                                        Choisir ma chanson
                                    </button>
                                {% elseif estInvite %}
                                    <button class="btn btn-sm text-white px-4" style="background-color: #E58E82;" onclick="ouvrirModalChanson('{{ battle.getIdBattle() }}')">
                                        {{ battle.getIdChansonParticipant() ? 'Changer ma chanson' : 'Accepter et choisir une chanson' }}
                                    </button>
                                {% else %}
                                    <span class="badge bg-warning text-dark px-3 py-2">EN ATTENTE DE PRÉPARATION</span>
                                {% endif %}
                            {% elseif battle.getStatutBattle().value == 'en_cours' %}
                                <span class="badge bg-success px-3 py-2">COMBAT EN COURS</span>
                                {# Les boutons de vote seront ajoutés à l'étape suivante #}
                            {% else %}
                                <span class="badge bg-secondary px-3 py-2">BATTLE TERMINÉE</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

{% include 'modales_battle.html.twig' %}

{% endblock %}