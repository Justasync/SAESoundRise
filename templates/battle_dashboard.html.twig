{% extends 'base_template.html.twig' %}

{% block title %}Gestion de mes Battles - Paaxio{% endblock %}

{% block header %}
    <link rel="stylesheet" href="assets/css/dataTables.bootstrap5.min.css">
    <style>
        /* --- CONFIGURATION ERGONOMIQUE & CHARTE GRAPHIQUE --- */
        #battlesTable_wrapper {
            --bs-pagination-color: #666;
            --bs-pagination-hover-color: #E58E82;
            --bs-pagination-active-bg: #E58E82; 
            --bs-pagination-active-border-color: #E58E82;
        }
        #battlesTable_wrapper .page-link { border-radius: 50% !important; margin: 0 3px; width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; }
        .dataTables_filter input { border-radius: 20px !important; padding: 8px 20px; border: 1px solid #dee2e6; width: 250px; transition: all 0.3s; }
        .dataTables_filter input:focus { border-color: #E58E82; box-shadow: 0 0 0 0.25rem rgba(229, 142, 130, 0.25); outline: none; }
        
        /* Bouton Nouvelle Battle - Mis à jour avec la couleur Corail Paaxio */
        .btn-nouvelle-battle {
            background-color: #E58E82;
            color: white;
            border-radius: 25px;
            padding: 10px 25px;
            font-weight: 600;
            transition: all 0.3s;
            border: none;
        }
        .btn-nouvelle-battle:hover {
            background-color: #d17a6f;
            transform: scale(1.05);
            box-shadow: 0 4px 15px rgba(229, 142, 130, 0.4);
            color: white;
        }

        .stat-card { transition: transform 0.2s; border-radius: 20px !important; }
        .table-container { background: white; border-radius: 20px; padding: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    </style>
{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h3 class="fw-bold text-dark mb-0">
            <i class="bi bi-trophy-fill me-2" style="color: #E58E82;"></i>Mes Battles
        </h3>
        <button class="btn btn-nouvelle-battle shadow-sm" onclick="ouvrirModalSelection()">
            <i class="bi bi-plus-lg me-2"></i>Nouvelle Battle
        </button>
    </div>

    {# Stats #}
    <div class="row mb-5 justify-content-center">
        <div class="col-md-3">
            <div class="card stat-card text-center shadow-sm border-0 p-3" style="background-color: #d4edda;">
                <h3 class="text-success fw-bold mb-0">{{ stats.victoires ?? 0 }}</h3>
                <p class="text-muted small mb-0">Victoires</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card text-center shadow-sm border-0 p-3" style="background-color: #f8d7da;">
                <h3 class="text-danger fw-bold mb-0">{{ stats.defaites ?? 0 }}</h3>
                <p class="text-muted small mb-0">Défaites</p>
            </div>
        </div>
    </div>

    <div class="table-container">
        <div class="table-responsive">
            <table id="battlesTable" class="table table-hover mb-0 align-middle" style="width:100%">
                <thead>
                    <tr>
                        <th>Combat</th>
                        <th>Adversaire</th>
                        <th>Lancée le</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for battle in battles %}
                        {% set estCreateur = (battle.getEmailCreateurBattle() == session.user_email) %}
                        {% set adversaire = estCreateur ? battle.getParticipant() : battle.getCreateur() %}
                        {% set status = battle.getStatutBattle().value %}
                        
                        <tr>
                            <td><span class="fw-bold text-dark">{{ battle.getTitreBattle()|replace({'Battle : ': ''}) }}</span></td>
                            <td>
                                {% if adversaire %}
                                    <div class="d-flex align-items-center">
                                        <img src="{{ adversaire.geturlPhotoUtilisateur() ?? 'assets/images/default-avatar.png' }}" class="rounded-circle me-2" width="35" height="35" style="object-fit: cover; border: 1px solid #eee;">
                                        <span class="small fw-semibold">{{ adversaire.getPseudoUtilisateur() }}</span>
                                    </div>
                                {% else %}<span class="text-muted small italic">En attente...</span>{% endif %}
                            </td>
                            
                            <td>
                                <div class="small fw-bold text-secondary">{{ battle.getDateDebutBattle()|date('d/m H:i') }}</div>
                                {% if status == 'en_cours' %}
                                    <div class="badge bg-light text-danger border mt-1" style="font-size: 0.65rem;">
                                        <i class="bi bi-clock-history me-1"></i>Fin : {{ battle.getDateFinBattle()|date('d/m H:i') }}
                                    </div>
                                {% endif %}
                            </td>

                            <td>
                                <span class="badge rounded-pill px-3 py-2 {% if status == 'en_cours' %}bg-success{% elseif status == 'en_attente' %}bg-warning text-dark{% elseif status == 'terminee' %}bg-secondary{% else %}bg-danger{% endif %}">
                                    {{ status|upper }}
                                </span>
                            </td>
                            <td class="text-end">
                                {# BOUTON SUPPRIMER : Uniquement si la battle est en attente et qu'on en est le créateur #}
                                {% if status == 'en_attente' and estCreateur %}
                                    <form action="?controller=battle&method=supprimer" method="POST" class="d-inline" onsubmit="return confirm('Voulez-vous vraiment annuler cette battle ?');">
                                        <input type="hidden" name="idBattle" value="{{ battle.getIdBattle() }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0 me-2" title="Supprimer la battle">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </form>
                                {% endif %}

                                {% if status == 'en_attente' %}
                                    {% set aDejaChoisi = (estCreateur and battle.getIdChansonCreateur()) or (not estCreateur and battle.getIdChansonParticipant()) %}
                                    <button class="btn btn-sm text-white px-3 shadow-sm" style="background-color: #E58E82; border-radius: 15px;" onclick="ouvrirModalChanson('{{ battle.getIdBattle() }}')">
                                        <i class="bi bi-music-note-beamed me-1"></i> {{ aDejaChoisi ? 'Changer chanson' : 'Choisir chanson' }}
                                    </button>
                                {% elseif status == 'en_cours' %}
                                    <a href="?controller=battle&method=lister" class="btn btn-sm btn-outline-success px-3" style="border-radius: 15px;">
                                        <i class="bi bi-eye me-1"></i> Voir l'arène
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% include 'modales_battle.html.twig' %}
{% endblock %}

{% block script %}
    {{ parent() }}
    <script src="assets/js/jquery.min.js"></script>
    <script src="assets/js/jquery.dataTables.min.js"></script>
    <script src="assets/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#battlesTable').DataTable({
                language: {
                    search: "",
                    searchPlaceholder: "Rechercher un battle...",
                    lengthMenu: "Afficher _MENU_",
                    info: "Affichage de _START_ à _END_ sur _TOTAL_ combats",
                    paginate: { previous: '<i class="bi bi-chevron-left"></i>', next: '<i class="bi bi-chevron-right"></i>' },
                    emptyTable: "Aucun battle trouvé"
                },
                pageLength: 10,
                dom: "<'row mb-4'<'col-md-6'l><'col-md-6 text-end'f>>" + "<'row'<'col-sm-12'tr>>" + "<'row mt-4'<'col-md-5'i><'col-md-7'p>>",
                order: [[3, 'asc']], 
                columnDefs: [{ orderable: false, targets: -1 }]
            });
        });
    </script>
{% endblock %}