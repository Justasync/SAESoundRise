{% extends "base_template.html.twig" %}

{% block header %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/dashboard.css">
{% endblock %}

{% block content %}
<main class="container-xl py-5 paaxio-dashboard">
    <div class="main-content-container bg-white">
        <div class="container-fluid pt-4 pb-2">

        {# Titre #}
        <section class="my-5 text-center">
            <h1 class="fw-bold mb-3 green-text">
                Espace Producteur
            </h1>
            <p class="text-muted">Vue d'ensemble de l’activité sur Paaxio.</p>
        </section>

        {# Artistes populaires #}
        <section class="mb-5">
            <h2 class="text-center fw-semibold mb-4 text-secondary pt-3">
                Artistes les plus écoutés
            </h2>

            <div class="artist-scroll-wrapper w-100 paaxio-horizontal-scroll rounded-4 shadow-lg">
                <div class="artist-list-container paaxio-horizontal-scroll">

                    {% if artistes is not empty %}
                        {% for artiste in artistes|slice(0,8) %}
                            {% set pseudo = (artiste.pseudoUtilisateur is defined and artiste.pseudoUtilisateur) ? artiste.pseudoUtilisateur : (artiste.getPseudoUtilisateur is defined ? artiste.getPseudoUtilisateur() : '') %}
                            {% set photo = (artiste.urlPhotoUtilisateur is defined and artiste.urlPhotoUtilisateur) ? artiste.urlPhotoUtilisateur : (artiste.geturlPhotoUtilisateur is defined ? artiste.geturlPhotoUtilisateur() : null) %}

                            <a href="/?controller=utilisateur&method=afficherProfilArtiste&pseudo={{ pseudo }}"
                               class="artist-item flex-shrink-0 d-flex flex-column align-items-center text-decoration-none"
                               title="{{ pseudo }}">
                                <img src="{{ photo ?: 'https://placehold.co/160x160/e9b7a6/ffffff?text=' ~ pseudo|first|upper }}"
                                     alt="Avatar de {{ pseudo }}"
                                     class="artist-avatar"
                                     onerror="this.onerror=null; this.src='https://placehold.co/160x160/e9b7a6/ffffff?text={{ pseudo|first|upper }}';">
                                <p class="green-text mb-0">
                                    {{ pseudo|length > 10 ? pseudo|slice(0,10) ~ '...' : pseudo }}
                                </p>
                            </a>
                        {% endfor %}
                    {% else %}
                        <p class="text-center text-gray-500 p-3 mb-0">
                            Aucun artiste à découvrir pour le moment.
                        </p>
                    {% endif %}

                </div>
            </div>
        </section>

        {# Statistiques #}
        <section class="mb-5">
            <h2 class="text-center fw-semibold mb-4 text-secondary pt-3">
                Statistiques Générales
            </h2>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="bg-paaxio-salmon p-4 rounded-4 shadow-lg text-center text-paaxio-turquoise">
                        <p class="fs-5 fw-medium mb-1 text-paaxio-turquoise">Artistes inscrits cette semaine</p>
                        <p class="display-5 fw-bold mb-0">
                            {{ stats.artistesInscritsSemaine }}
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="bg-paaxio-salmon p-4 rounded-4 shadow-lg text-center text-paaxio-turquoise">
                        <p class="fs-5 fw-medium mb-1 text-paaxio-turquoise">Artistes trouvés</p>
                        <p class="display-5 fw-bold mb-0">
                            {{ stats.artistesTrouves }}
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="bg-paaxio-salmon p-4 rounded-4 shadow-lg text-center text-paaxio-turquoise">
                        <p class="fs-5 fw-medium mb-1 text-paaxio-turquoise">Top Battles</p>
                        <p class="fw-bold mb-0">
                            {{ stats.artistePlusBatailles }}
                        </p>
                    </div>
                </div>
            </div>
        </section>

        {# Albums populaires #}
        <section class="mb-5">
            <h2 class="text-center fw-semibold mb-4 text-secondary pt-3">
                Albums les plus écoutés
            </h2>

            <div class="d-flex gap-4 flex-wrap">

                {% if albums is not empty %}
                    {% for album in albums|slice(0,4) %}
                        <a href="/?controller=album&method=afficherDetails&idAlbum={{ album.getIdAlbum() }}"
                        class="flex-shrink-0 bg-paaxio-salmon p-2 rounded-4 shadow-lg text-decoration-none hover-bg-terracotta"
                        style="width: 12rem; height: 12rem;">

                            {# Image de l'album #}
                            <img
                                src="{{ album.getUrlPochetteAlbum() ?: 'https://placehold.co/200x200/e9b7a6/ffffff?text=' ~ album.getTitreAlbum()|first|upper }}"
                                alt="Pochette de {{ album.getTitreAlbum() }}"
                                class="rounded-3 object-cover m-1 shadow-sm"
                                style="height: 70%; width: calc(100% - 0.5rem); object-fit: cover;"
                                onerror="this.onerror=null; this.src='https://placehold.co/200x200/e9b7a6/ffffff?text={{ album.getTitreAlbum()|first|upper }}';"
                            >

                            {# Titre de l'album #}
                            <div class="d-flex align-items-center justify-content-center p-1" style="height: 30%;">
                                <p class="mb-0 album-title text-center">
                                    {{ album.getTitreAlbum() }}
                                </p>
                            </div>

                        </a>
                    {% endfor %}
                {% else %}
                    <p class="text-center col-12">
                        Aucun album populaire pour le moment.
                    </p>
                {% endif %}

            </div>
        </section>

        </div>
    </div>
</main>
{% endblock %}

{% block script %}
    {{ parent() }}
{% endblock %}