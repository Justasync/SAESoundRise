		<!DOCTYPE html>
		<html lang="fr">
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<link rel="stylesheet" type="text/css" href="/assets/css/bootstrap.css">
			<link rel="stylesheet" href="/assets/css/styles.css">
			<script src="/assets/js/bootstrap.bundle.js"></script>
			<script src="tarteaucitron/tarteaucitron.min.js"></script>
			<link rel="icon" type="image/x-icon" href="/assets/images/logos/paaxio_logo_noir.ico">
			<script src="tarteaucitron_init.js"></script>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
			<link rel="stylesheet" href="/assets/css/signup-modal.css">
			<link rel="stylesheet" href="/assets/css/body.css">
			<link rel="stylesheet" href="/assets/css/header.css">
			<link rel="stylesheet" href="/assets/css/footer.css">
			<link rel="stylesheet" href="/assets/css/chat.css">
			<link rel="stylesheet" href="/assets/css/utilisateur_gestion_profil.css">
			<link rel="stylesheet" href="/assets/css/utilisateur_securite.css">
			<link rel="stylesheet" href="/assets/css/utilisateur_abonnement.css">
			<!-- Meta OG -->
			<meta property="og:title" content="{{ page.title is defined ? page.title : 'Paaxio' }}"/>
			<meta property="og:description" content="{{ page.description is defined ? page.description : '' }}"/>
			<meta property="og:image" content="/assets/images/banners/banner.png">
			<meta property="og:image:width" content="1200"/>
			<meta property="og:image:height" content="630"/>
			<meta property="og:type" content="website"/>
			<meta property="og:url" content="https://paaxio.com/"/>
			<meta property="og:site_name" content="Paaxio"/>
			<meta property="og:locale" content="fr_FR"/>
			<title>{{ page.title is defined ? page.title : 'Paaxio' }}</title>
			{% if page.description is defined %}
				<meta name="description" content="{{ page.description }} ">
			{% endif %}
			{% block header %}{% endblock %}
			<style>
				html, body { height: 100%; min-height: 100%; }
				body { display: flex; min-height: 100vh; flex-direction: column; }
				main.paaxio-content-wrapper { flex: 1 0 auto; }
				footer { flex-shrink: 0; }
			</style>
		</head>
		<body>
			<header>
				<nav class="navbar navbar-expand-lg" aria-label="Menu principal Paaxio">
					<div class="container-fluid">
						<a class="navbar-brand {% if session.user_logged_in is defined and session.user_logged_in %}header-shift-up{% endif %}" href="/?controller=home&method=afficher" aria-label="Accueil Paaxio">
							<img src="assets/images/logos/paaxio_logo_nom_droit_noir.svg" alt="Logo Paaxio" width="150">
						</a>
						<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Afficher le menu">
							<span class="navbar-toggler-icon"></span>
						</button>
						<div class="collapse navbar-collapse flex-column" id="navbarSupportedContent">
							<ul class="navbar-nav mx-auto mb-2 mb-lg-0" aria-label="Navigation principale">
								{% if session.user_logged_in is defined and session.user_logged_in and session.user_role is defined and session.user_role.value == 'admin' %}
									<li class="nav-item">
										<a class="nav-link fs-4 {% if page.name is defined and page.name == 'admin' %}active{% endif %}" href="/?controller=admin&method=afficher" aria-label="Administration" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Espace administrateur">
											<i class="bi bi-shield-lock" aria-hidden="true"></i> Admin
										</a>
									</li>
									<li class="nav-item">
										<a class="nav-link fs-4 {% if page.name is defined and page.name == 'admin_sauvegardes' %}active{% endif %}" aria-current="page" href="/?controller=admin&method=sauvegardes" aria-label="Sauvegardes" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Gestion des sauvegardes">
											<i class="bi bi-hdd-network" aria-hidden="true"></i> Sauvegardes
										</a>
									</li>
								{% else %}
									{% if session.user_logged_in is defined and session.user_logged_in %}
										{% if session.user_role is defined and session.user_role.value == 'artiste' %}
											<li class="nav-item nav-item-offset">
												<a class="nav-link fs-4 {% if page.name is defined and page.name == 'maMusique' %}active{% endif %}" href="/?controller=album&method=afficherMaMusique" aria-label="Ma Musique" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Voir ma musique">
													<i class="bi bi-music-note-list" aria-hidden="true"></i> Ma Musique
												</a>
											</li>
										{% endif %}
										<li class="nav-item nav-item-offset">
											<a class="nav-link fs-4 {% if page.name is defined and page.name == 'maBiblio' %}active{% endif %}" href="/?controller=musique&method=afficher" aria-label="Bibliothèque" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Accéder à la bibliothèque">
												<i class="bi bi-collection" aria-hidden="true"></i> Bibliothèque
											</a>
										</li>
										<li class="nav-item nav-item-offset">
											<a class="nav-link fs-4 {% if page.name is defined and page.name == 'battle' %}active{% endif %}" href="?controller=battle&method=lister" aria-label="Battle musical" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Participer à un battle">
												<i class="bi bi-lightning" aria-hidden="true"></i> Battle
											</a>
										</li>
									{% endif %}
								{% endif %}
							</ul>
							<div class="search-bar mx-auto w-50 position-relative mb-3">
								<form action="index.php" method="get" role="search" aria-label="Recherche globale" class="needs-validation" novalidate>
									<input id="searchInput" name="term" class="form-control" type="search" placeholder="Rechercher" autocomplete="off" aria-label="Champ de recherche">
								</form>
								<div id="searchResults" class="list-group position-absolute w-100 shadow" style="display:none; z-index:9999; top:100%; left:0; background:white; max-height:300px; overflow-y:auto;"></div>
							</div>
						</div>
						<div class="d-flex align-items-center gap-1 ms-auto {% if session.user_logged_in is defined and session.user_logged_in %}header-shift-up{% endif %}">
							<button id="darkModeToggle" class="btn btn-outline-primary me-2" aria-label="Activer ou désactiver le mode sombre" title="Mode sombre" data-bs-toggle="tooltip" data-bs-placement="bottom">
								<i class="bi bi-moon-stars"></i>
							</button>
							{% if session.user_logged_in is defined and session.user_logged_in %}
								<a class="btn text-secondary d-flex align-items-center justify-content-center position-relative {% if page.name is defined and page.name == 'messages' %}text-primary{% endif %}" href="?controller=message&method=lister" title="Messages" aria-label="Accéder à la messagerie" data-bs-toggle="tooltip" data-bs-placement="bottom">
									<i class="bi bi-chat-dots fs-4" aria-hidden="true"></i>
									{% if unreadMessagesCount is defined and unreadMessagesCount > 0 %}
										<span class="nav-unread-badge" aria-hidden="true">
											{{ unreadMessagesCount > 9 ? '9+' : unreadMessagesCount }}
										</span>
									{% endif %}
								</a>
							{% endif %}
							{% if session.user_logged_in is defined and session.user_logged_in and session.user_role is defined and session.user_role.value == 'artiste' %}
								<a class="btn text-secondary d-flex align-items-center justify-content-center" href="/?controller=album&method=afficherFormulaireAjout" title="Publier un album" aria-label="Publier un album ou single" data-bs-toggle="tooltip" data-bs-placement="bottom">
									<i class="bi bi-cloud-upload fs-4" aria-hidden="true"></i>
								</a>
							{% endif %}
							<div class="dropdown">
								<button class="btn text-secondary d-flex align-items-center justify-content-center dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu utilisateur">
									<i class="bi bi-person-circle fs-4" aria-hidden="true"></i>
								</button>
								<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown" style="min-width:180px;" aria-label="Menu utilisateur déroulant">
									{% if session.user_logged_in is defined and session.user_logged_in %}
										<li>
											<a class="dropdown-item" href="/?controller=utilisateur&method=afficherProfilArtiste&pseudo={{session.user_pseudo}}" aria-label="Voir mon profil">
												<i class="bi bi-person-circle me-2" aria-hidden="true"></i>Mon Profil
											</a>
										</li>
										<li>
											<a class="dropdown-item" href="/?controller=utilisateur&method=afficherGestionProfil" aria-label="Paramètres du compte">
												<i class="bi bi-gear me-2" aria-hidden="true"></i>Paramètres
											</a>
										</li>
										<li><hr class="dropdown-divider"></li>
										<li>
											<a class="dropdown-item text-danger" href="/?controller=utilisateur&method=logout" aria-label="Déconnexion">
												<i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Déconnexion
											</a>
										</li>
									{% else %}
										<li>
											<a class="dropdown-item" href="#" id="trigger-login-modal" aria-label="Se connecter">
												<i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Se connecter
											</a>
										</li>
										<li>
											<a class="dropdown-item" href="#" id="trigger-signup-modal" aria-label="S'inscrire">
												<i class="bi bi-person-plus me-2" aria-hidden="true"></i>S'inscrire
											</a>
										</li>
									{% endif %}
								</ul>
							</div>
						</div>
					</div>
				</nav>
			</header>
			<main class="paaxio-content-wrapper"> {% block content %}{% endblock %}</main>
			<!-- Sign-up Modal -->
			<!-- Sign-in Modal -->
			<footer class="footer py-3 my-4" aria-label="Pied de page Paaxio">
				<ul class="nav justify-content-center border-bottom pb-3 mb-3" aria-label="Liens de pied de page">
					<li class="nav-item">
						<a href="/?controller=newsletter&method=afficher" class="nav-link px-2 text-body-secondary" aria-label="Accéder à la newsletter" data-bs-toggle="tooltip" data-bs-placement="top" title="Recevoir les actualités Paaxio">Newsletter</a>
					</li>
					<li class="nav-item">
						<a href="/?controller=home&method=afficherLegales" class="nav-link px-2 text-body-secondary" aria-label="Mentions légales" data-bs-toggle="tooltip" data-bs-placement="top" title="Informations légales">Mentions légales</a>
					</li>
				</ul>
				<div class="d-flex justify-content-center">
					<a href="/?controller=home&method=afficher" class="d-flex align-items-center mb-3 link-body-emphasis text-decoration-none" aria-label="Paaxio">
						<img src="assets/images/logos/paaxio_logo_noir.svg" alt="Paaxio" height="50">
					</a>
				</div>
				<p class="text-center text-body-secondary">&copy; 2025 Paaxio</p>
			</footer>
            
			<script>
				document.addEventListener('DOMContentLoaded', function () {
					// Modales connexion/inscription
					var triggerLoginModal = document.getElementById('trigger-login-modal');
					if (triggerLoginModal) {
						triggerLoginModal.addEventListener('click', function (e) {
							e.preventDefault();
							var signinModal = new bootstrap.Modal(document.getElementById('signinModal'));
							signinModal.show();
						});
					}
					var triggerSignupModal = document.getElementById('trigger-signup-modal');
					if (triggerSignupModal) {
						triggerSignupModal.addEventListener('click', function (e) {
							e.preventDefault();
							var signupModal = new bootstrap.Modal(document.getElementById('signupModal'));
							signupModal.show();
						});
					}
					// Tooltips Bootstrap
					var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
					tooltipTriggerList.forEach(function (tooltipTriggerEl) {
						new bootstrap.Tooltip(tooltipTriggerEl);
					});

					// Switch mode sombre
					var darkModeToggle = document.getElementById('darkModeToggle');
					var body = document.body;
					if (localStorage.getItem('paaxioDarkMode') === 'true') {
						body.classList.add('dark-mode');
					}
					if (darkModeToggle) {
						darkModeToggle.addEventListener('click', function () {
							body.classList.toggle('dark-mode');
							localStorage.setItem('paaxioDarkMode', body.classList.contains('dark-mode'));
						});
					}
				});
			</script>
			<script src="/assets/js/bootstrap.bundle.js"></script>
			<script src="assets/js/signup-modal.js?v=1.0b4"></script>
			<script src="assets/js/signin-modal.js?v=1.0b4"></script>
			<script src="assets/js/search.js"></script>
			<script src="assets/js/form-validation.js"></script>
			<script>
				document.addEventListener('DOMContentLoaded', function () {
					var userDropdownBtn = document.getElementById('userDropdown');
					if (userDropdownBtn) {
						userDropdownBtn.addEventListener('click', function (e) {
							e.preventDefault();
							e.stopPropagation();
							var dropdown = bootstrap.Dropdown.getOrCreateInstance(userDropdownBtn);
							dropdown.toggle();
						});
					}
				});
			</script>
		</body>
		</html>

