{% extends "base_template.html.twig" %}

{% block header %}
	{{ parent() }}
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="/assets/css/dashboard.css">
	<link rel="stylesheet" href="/assets/css/album_details.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
{% endblock %}

{% block content %}
	{% set totalDuration = 0 %}
	{% for chanson in chansons %}
		{% set totalDuration = totalDuration + chanson.getDureeChanson() %}
	{% endfor %}
	{% set totalMinutes = (totalDuration / 60)|round(0, 'floor') %}
	{% set totalSeconds = totalDuration % 60 %}
	{% set totalSecondsPadded = '%02d'|format(totalSeconds) %}

	<main class="container-xl py-5 paaxio-dashboard paaxio-album-details">
		<div class="main-content-container bg-white">
			<div class="container-fluid pt-4 pb-2">
				<section class="paaxio-album-details__hero p-3 p-lg-5">

			<div class="d-flex flex-column flex-md-row align-items-start gap-4">
				<div class="flex-shrink-0">
					<img id="album-cover" src="{{ album.getUrlPochetteAlbum() ?: 'https://placehold.co/160x160/7b4343/ffffff?text=' ~ (album.getTitreAlbum()|replace({' ': '+'})|slice(0, 20)) }}" alt="Couverture de l'album {{ album.getTitreAlbum() }}" class="paaxio-album-details__cover">
				</div>

				<div class="flex-grow-1">
					<span class="text-sm fw-light text-uppercase paaxio-album-details__kicker">Album</span>
					<h2 class="display-4 fw-bolder mt-1 mb-2 paaxio-album-details__title">{{ album.getTitreAlbum() }}</h2>
					<p class="fs-5 fw-light paaxio-album-details__meta">
						{{ album.getArtisteAlbum() }}
						{% if album.getDateSortieAlbum() %}
							·
							{{ album.getDateSortieAlbum()|date('Y') }}
						{% endif %}
						·
						{{ chansons|length }}
						titre{{ chansons|length > 1 ? 's' : '' }},
						{{ totalMinutes }}
						min
						{{ totalSecondsPadded }}
						s
					</p>

					<div class="mt-4 pt-4 border-top border-light border-opacity-50">
						<p class="fs-6 fw-bold mb-2" id="current-track-title">Piste en cours : Aucune</p>
						<div id="progress-bar-container" class="rounded-pill">
							<div id="progress-bar" class="rounded-pill w-0"></div>
						</div>
						<div class="d-flex justify-content-between text-xs mt-1" style="opacity: 0.8;">
							<span id="current-time">0:00</span>
							<span id="duration">0:00</span>
						</div>
						<div class="mt-3 d-flex gap-3 align-items-center">
							<button id="play-pause-btn" type="button" onclick="playSelected()" class="btn btn-light text-dark rounded-circle shadow-sm" style="width: 48px; height: 48px;">
								<i id="play-pause-icon" class="bi bi-play-fill" style="font-size: 1.5rem; line-height: 1;"></i>
							</button>
							<div class="d-flex align-items-center ms-auto gap-2">
								<button id="volume-btn" type="button" class="btn btn-link p-0">
									<i id="volume-icon" class="bi bi-volume-up-fill" style="font-size: 1.8rem; color: rgba(255, 255, 255, 0.9);"></i>
								</button>
								<input type="range" id="volume-slider" min="0" max="100" value="75" class="align-self-center">
							</div>
						</div>
					</div>

					<button type="button" class="btn btn-light text-dark fw-semibold py-2 px-4 rounded-pill shadow-lg mt-3" data-bs-toggle="modal" data-bs-target="#ajoutChansonModal">
						Ajouter Titre
					</button>
				</div>
			</div>

			</section>

			<div class="mt-4 paaxio-album-details__tableWrap">
				<table id="track-table" class="table table-hover align-middle paaxio-album-details__table">
					<thead class="paaxio-album-details__thead">
						<tr class="text-sm text-uppercase fw-semibold">
							<th scope="col" class="py-3 px-4" style="width: 5%;">#</th>
							<th scope="col" class="py-3 px-4" style="width: 55%;">Titre</th>
							<th scope="col" class="py-3 px-4 d-none d-sm-table-cell" style="width: 20%;">Nombre d'écoutes</th>
							<th scope="col" class="py-3 px-4" style="width: 10%;">Durée</th>
							<th scope="col" class="py-3 px-4" style="width: 10%;"></th>
						</tr>
					</thead>
					<tbody>
						{% if chansons is not empty %}
							{% for chanson in chansons %}
								<tr class="track-row paaxio-album-details__row" data-index="{{ loop.index0 }}" data-song-id="{{ chanson.getIdChanson() }}">
									<td class="py-3 px-4 fw-bold track-index">
										<span class="track-index-number">{{ loop.index }}</span>
										<span class="track-index-play" data-index="{{ loop.index0 }}" onclick="event.stopPropagation(); loadTrack({{ loop.index0 }})">
											<i class="bi bi-play-fill track-play-icon paaxio-album-details__iconBtn" style="font-size: 1rem;"></i>
										</span>
									</td>
									<td class="py-3 px-4 track-title">{{ chanson.getTitreChanson() }}</td>
									<td class="py-3 px-4 d-none d-sm-table-cell track-listens">{{ chanson.getNbEcouteChanson() ?? 0 }}</td>
									<td class="py-3 px-4 track-duration">{{ (chanson.getDureeChanson() / 60)|round(0, 'floor') }}:{{ '%02d'|format(chanson.getDureeChanson() % 60) }}</td>
									<td class="py-3 px-4 text-center">
										<button type="button" class="btn btn-sm btn-link p-1" title="Modifier" data-bs-toggle="modal" data-bs-target="#modifierChansonModal" data-song-id="{{ chanson.getIdChanson() }}" data-song-title="{{ chanson.getTitreChanson() }}" data-song-genre="{{ chanson.getGenreChanson() ? chanson.getGenreChanson().getNomGenre() : '' }}">
											<svg class="bi paaxio-album-details__iconBtn" width="16" height="16" fill="currentColor">
												<path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207l6.5-6.5zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
											</svg>
										</button>
										<button title="Supprimer" class="btn btn-sm btn-link p-1" data-bs-toggle="modal" data-bs-target="#supprimerChansonModal" data-song-id="{{ chanson.getIdChanson() }}" data-song-title="{{ chanson.getTitreChanson() }}">
											<svg class="bi paaxio-album-details__iconBtn" width="16" height="16" fill="currentColor">
												<path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
												<path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
											</svg>
										</button>
									</td>
								</tr>
							{% endfor %}
						{% else %}
							<tr>
								<td colspan="5" class="text-center py-4 text-muted">Cet album ne contient aucune chanson pour le moment.</td>
							</tr>
						{% endif %}
					</tbody>
				</table>
			</div>
			</div>
		</div>
	</main>

	<audio id="audio-player"></audio>

	<!-- Fenêtre Modale pour l'ajout de chanson -->
	<div class="modal fade" id="ajoutChansonModal" tabindex="-1" aria-labelledby="ajoutChansonModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="ajoutChansonModalLabel">Ajouter une chanson à "{{ album.getTitreAlbum() }}"</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div
					class="modal-body">
					{# Inclusion du formulaire partiel #}
					{% include '_song_upload_form.html.twig' with {'album_existant': album} %}
				</div>
			</div>
		</div>
	</div>
    <!-- Fenêtre Modale pour la suppression de chanson -->
    <div class="modal fade" id="supprimerChansonModal" tabindex="-1" aria-labelledby="supprimerChansonModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" id="supprimerChansonForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="supprimerChansonModalLabel">Confirmer la suppression</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="id_album" value="{{ album.getIdAlbum() }}">
                        <p>Êtes-vous sûr de vouloir supprimer la chanson : <strong id="song-to-delete">-</strong> ?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

	<!-- Fenêtre Modale pour la modification de chanson -->
	<div class="modal fade" id="modifierChansonModal" tabindex="-1" aria-labelledby="modifierChansonModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<form
					method="post">
					{# L'action sera définie par le JS #}
					<div class="modal-header">
						<h5 class="modal-title" id="modifierChansonModalLabel">Modifier la chanson</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						<input type="hidden" name="id_album" value="{{ album.getIdAlbum() }}">
						<div class="mb-3">
							<label for="edit-song-title" class="form-label">Titre de la chanson</label>
							<input type="text" class="form-control" id="edit-song-title" name="titre_chanson" required>
						</div>
						<div class="mb-3">
							<label for="edit-song-genre" class="form-label">Genre</label>
							<select class="form-control" id="edit-song-genre" name="genre_chanson">
								<option value="">Choisir un genre</option>
								{% for genre in genres %}
								<option value="{{ genre.getNomGenre() }}">{{ genre.getNomGenre() }}</option>
								{% endfor %}
							</select>
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
						<button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
					</div>
				</form>
			</div>
		</div>
	</div>
{% endblock %}
{% block script %}
	{{ parent() }}
	<script>
const audioPlayer = document.getElementById('audio-player');
const playPauseIcon = document.getElementById('play-pause-icon');
const progressBar = document.getElementById('progress-bar');
const progressBarContainer = document.getElementById('progress-bar-container');
const currentTimeEl = document.getElementById('current-time');
const durationEl = document.getElementById('duration');
const currentTrackTitleEl = document.getElementById('current-track-title');
const trackRows = document.querySelectorAll('.track-row');
const albumCover = document.getElementById('album-cover');
const volumeSlider = document.getElementById('volume-slider');
const volumeIcon = document.getElementById('volume-icon');

let currentTrackIndex = -1;
let isScrubbing = false;
let wasPlayingBeforeScrub = false;
let isPlaying = false;

const playlist = [];
{% for chanson in chansons %}
playlist.push({
	id: {{ chanson.getIdChanson() }},
	title: "{{ chanson.getTitreChanson()|e('js') }}",
	src: "{{ chanson.geturlAudioChanson()|default('https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3')|e('js') }}",
	durationFormatted: "{{ (chanson.getDureeChanson() / 60)|round(0, 'floor') }}:{{ '%02d'|format(chanson.getDureeChanson() % 60) }}"
});
{% endfor %}

const playedBeyond75 = new Set();
const selectedSongId = {{ chansonSelected ?? 'null' }};

function formatTime(seconds) {
	const minutes = Math.floor(seconds / 60);
	const remainingSeconds = Math.floor(seconds % 60);
	return `${minutes}:${remainingSeconds < 10 ? '0' : ''}${remainingSeconds}`;
}

function updateProgress() {
	if (audioPlayer.duration && !isScrubbing) {
		const progressPercent = (audioPlayer.currentTime / audioPlayer.duration) * 100;
		progressBar.style.width = `${progressPercent}%`;
		currentTimeEl.textContent = formatTime(audioPlayer.currentTime);
	}
}

function handleScrubbing(event) {
	if (!audioPlayer.src) return;
	const rect = progressBarContainer.getBoundingClientRect();
	const offsetX = event.clientX - rect.left;
	const width = progressBarContainer.offsetWidth;
	const newTimeFraction = Math.max(0, Math.min(1, offsetX / width));

	if (audioPlayer.duration) {
		const newTime = newTimeFraction * audioPlayer.duration;
		audioPlayer.currentTime = newTime;
		progressBar.style.width = `${newTimeFraction * 100}%`;
		currentTimeEl.textContent = formatTime(newTime);
	}
}

window.playPause = function () {
	if (currentTrackIndex === -1 && playlist.length > 0) {
		loadTrack(0);
		return;
	}
	if (isPlaying) {
		audioPlayer.pause();
		playPauseIcon.classList.replace('bi-pause-fill', 'bi-play-fill');
	} else {
		audioPlayer.play().catch(e => console.error("Erreur de lecture : ", e));
		playPauseIcon.classList.replace('bi-play-fill', 'bi-pause-fill');
	}
	isPlaying = !isPlaying;
	updateTrackRowVisuals();
};

progressBarContainer.addEventListener('mousedown', (e) => {
	if (!audioPlayer.src) return;
	isScrubbing = true;
	wasPlayingBeforeScrub = isPlaying;
	if (wasPlayingBeforeScrub) {
		audioPlayer.pause();
	}
	handleScrubbing(e);
});

document.addEventListener('mousemove', (e) => {
	if (isScrubbing) {
		e.preventDefault();
		handleScrubbing(e);
	}
});

document.addEventListener('mouseup', () => {
	if (isScrubbing) {
		if (wasPlayingBeforeScrub) {
			audioPlayer.play().catch(e => console.error("Erreur de lecture post-scrubbing : ", e));
		}
		isScrubbing = false;
	}
});

window.playSelected = function () {
	const selectedRow = document.querySelector('.track-row.selected-track') || document.querySelector('.track-row.active-track');
	let index = -1;
	if (selectedRow) {
		index = parseInt(selectedRow.dataset.index, 10);
	}
	if (isNaN(index) || index < 0) {
		if (currentTrackIndex === -1 && playlist.length > 0) {
			loadTrack(0);
		} else {
			playPause();
		}
		return;
	}
	if (index === currentTrackIndex) {
		playPause();
	} else {
		loadTrack(index);
	}
};

window.loadTrack = function (index) {
	if (index < 0 || index >= playlist.length) {
		console.error("Index de piste invalide.");
		return;
	}
	const track = playlist[index];
	playedBeyond75.delete(track.id);

	if (index === currentTrackIndex && !isPlaying) {
		audioPlayer.play().catch(e => console.error("Erreur de lecture : ", e));
		isPlaying = true;
		playPauseIcon.classList.replace('bi-play-fill', 'bi-pause-fill');
		updateTrackRowVisuals();
		return;
	}

	currentTrackIndex = index;
	audioPlayer.src = track.src;
	currentTrackTitleEl.textContent = `Piste en cours : ${index + 1}. ${track.title}`;
	durationEl.textContent = track.durationFormatted;

	audioPlayer.play().catch(e => {
		console.error("Lecture automatique bloquée. Veuillez interagir.", e);
		isPlaying = false;
		playPauseIcon.classList.replace('bi-pause-fill', 'bi-play-fill');
	});
	isPlaying = true;
	playPauseIcon.classList.replace('bi-play-fill', 'bi-pause-fill');
	updateTrackRowVisuals();
};

function updateTrackRowVisuals() {
	trackRows.forEach((row, index) => {
		const playIcon = row.querySelector('.track-play-icon');
		if (index === currentTrackIndex) {
			row.classList.add('active-track');
		} else {
			row.classList.remove('active-track');
		}
		if (playIcon) {
			if (index === currentTrackIndex && isPlaying) {
				playIcon.classList.replace('bi-play-fill', 'bi-pause-fill');
			} else {
				playIcon.classList.replace('bi-pause-fill', 'bi-play-fill');
			}
		}
	});
}

audioPlayer.addEventListener('play', () => {
	if (albumCover) albumCover.classList.add('rotating');
});

audioPlayer.addEventListener('pause', () => {
	if (albumCover) albumCover.classList.remove('rotating');
});

audioPlayer.addEventListener('loadedmetadata', () => {
	if (audioPlayer.duration && !isNaN(audioPlayer.duration)) {
		durationEl.textContent = formatTime(audioPlayer.duration);
	}
});

audioPlayer.addEventListener('timeupdate', () => {
	if (currentTrackIndex >= 0 && audioPlayer.duration) {
		const track = playlist[currentTrackIndex];
		const threshold75 = audioPlayer.duration * 0.75;
		if (audioPlayer.currentTime >= threshold75 && !playedBeyond75.has(track.id)) {
			playedBeyond75.add(track.id);
			fetch('/?controller=chanson&method=incrementEcoute', {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
				body: 'idChanson=' + encodeURIComponent(track.id)
			})
			.then(res => res.json())
			.then(data => {
				if (data && data.nbEcoute !== undefined) {
					const row = document.querySelector('.track-row[data-index="' + currentTrackIndex + '"]');
					if (row) {
						const listensCell = row.querySelector('.track-listens');
						if (listensCell) listensCell.textContent = data.nbEcoute;
					}
				}
			})
			.catch(err => console.error('Erreur incrément écoute:', err));
		}
	}
	updateProgress();
});

audioPlayer.addEventListener('ended', () => {
	if (currentTrackIndex < playlist.length - 1) {
		loadTrack(currentTrackIndex + 1);
	} else {
		isPlaying = false;
		playPauseIcon.classList.replace('bi-pause-fill', 'bi-play-fill');
		audioPlayer.currentTime = 0;
		progressBar.style.width = '0%';
		currentTimeEl.textContent = '0:00';
		currentTrackTitleEl.textContent = 'Piste en cours : Aucune';
		updateTrackRowVisuals();
	}
});

audioPlayer.addEventListener('error', (e) => {
	console.error("Erreur de l'élément audio:", audioPlayer.error, e);
	currentTrackTitleEl.textContent = "Erreur de chargement de la piste.";
	isPlaying = false;
	playPauseIcon.classList.replace('bi-pause-fill', 'bi-play-fill');
	updateTrackRowVisuals();
});

window.onload = function () {
	trackRows.forEach((row) => {
		const index = parseInt(row.dataset.index);
		row.addEventListener('click', (e) => {
			if (!e.target.closest('button')) {
				loadTrack(index);
			}
		});
	});

	if (selectedSongId !== null && playlist.length > 0) {
		const selectedIndex = playlist.findIndex(track => track.id === selectedSongId);
		if (selectedIndex !== -1) {
			const selectedRow = document.querySelector('tr[data-song-id="' + selectedSongId + '"]');
			if (selectedRow) {
				setTimeout(() => {
					selectedRow.scrollIntoView({behavior: 'smooth', block: 'center'});
				}, 100);
			}
			currentTrackIndex = selectedIndex;
			const track = playlist[selectedIndex];
			audioPlayer.src = track.src;
			currentTrackTitleEl.textContent = `Piste en cours : ${currentTrackIndex + 1}. ${track.title}`;
			durationEl.textContent = track.durationFormatted;
			updateTrackRowVisuals();
		} else if (playlist.length > 0) {
			currentTrackIndex = 0;
			const track = playlist[0];
			audioPlayer.src = track.src;
			currentTrackTitleEl.textContent = `Piste en cours : ${currentTrackIndex + 1}. ${track.title}`;
			durationEl.textContent = track.durationFormatted;
			updateTrackRowVisuals();
		}
	} else if (playlist.length > 0) {
		currentTrackIndex = 0;
		const track = playlist[0];
		audioPlayer.src = track.src;
		currentTrackTitleEl.textContent = `Piste en cours : ${currentTrackIndex + 1}. ${track.title}`;
		durationEl.textContent = track.durationFormatted;
		updateTrackRowVisuals();
	}
};

function handleVolumeChange() {
	const volume = volumeSlider.value / 100;
	audioPlayer.volume = volume;
	audioPlayer.muted = (volume === 0);

	if (audioPlayer.muted || volume === 0) {
		volumeIcon.classList.replace('bi-volume-up-fill', 'bi-volume-mute-fill');
		volumeIcon.classList.replace('bi-volume-down-fill', 'bi-volume-mute-fill');
	} else if (volume > 0.5) {
		volumeIcon.classList.replace('bi-volume-mute-fill', 'bi-volume-up-fill');
		volumeIcon.classList.replace('bi-volume-down-fill', 'bi-volume-up-fill');
	} else {
		volumeIcon.classList.replace('bi-volume-mute-fill', 'bi-volume-down-fill');
		volumeIcon.classList.replace('bi-volume-up-fill', 'bi-volume-down-fill');
	}
}

if (volumeSlider) {
	volumeSlider.addEventListener('input', handleVolumeChange);
}

const volumeBtn = document.getElementById('volume-btn');
if (volumeBtn) {
	volumeBtn.addEventListener('click', () => {
		audioPlayer.muted = !audioPlayer.muted;
		if (audioPlayer.muted) {
			volumeSlider.value = 0;
		} else {
			volumeSlider.value = audioPlayer.volume > 0 ? audioPlayer.volume * 100 : 75;
		}
		handleVolumeChange();
	});
}

handleVolumeChange();

document.addEventListener('DOMContentLoaded', function () {
	const modifierModal = document.getElementById('modifierChansonModal');
	if (modifierModal) {
		modifierModal.addEventListener('show.bs.modal', function (event) {
			const button = event.relatedTarget;
			const songId = button.getAttribute('data-song-id');
			const songTitle = button.getAttribute('data-song-title');
			const songGenre = button.getAttribute('data-song-genre');

			const modalTitle = modifierModal.querySelector('.modal-title');
			const modalForm = modifierModal.querySelector('form');
			const titleInput = modifierModal.querySelector('#edit-song-title');
			const genreSelect = modifierModal.querySelector('#edit-song-genre');

			modalTitle.textContent = 'Modifier : ' + songTitle;
			titleInput.value = songTitle;
			genreSelect.value = songGenre || '';
			modalForm.action = '/?controller=album&method=modifierChanson&idChanson=' + songId;
		});
	}

	const supprimerModal = document.getElementById('supprimerChansonModal');
	if (supprimerModal) {
		supprimerModal.addEventListener('show.bs.modal', function (event) {
			const button = event.relatedTarget;
			const songId = button.getAttribute('data-song-id');
			const songTitle = button.getAttribute('data-song-title');
			const form = supprimerModal.querySelector('form');
			const songToDelete = document.getElementById('song-to-delete');
			if (songToDelete) {
				songToDelete.textContent = songTitle;
			}
			if (form) {
				form.action = '/?controller=album&method=supprimerChanson&idChanson=' + songId;
			}
		});
	}
});
	</script>
{% endblock %}
