{# MODAL 1 : Sélection Artiste #}
<div id="modalSelection" class="battle-modal" style="display:none;">
    <div class="battle-modal-content">
        <h3 class="text-center fw-bold mb-3">Rechercher un artiste</h3>
        <div class="table-responsive" style="max-height: 250px;">
            <table class="table table-hover">
                <thead style="background-color: #E58E82; color: white;"><tr><th>Artiste</th><th>Genre</th></tr></thead>
                <tbody style="background-color: white;">
                    {% for artiste in artistesDisponibles %}
                        <tr onclick="selectionnerArtiste(this, '{{ artiste.getEmailUtilisateur() }}', '{{ artiste.getPseudoUtilisateur() }}')" style="cursor:pointer;">
                            <td><input type="radio" name="artisteRadio" class="form-check-input me-2"> {{ artiste.getPseudoUtilisateur() }}</td>
                            <td>{{ artiste.getGenreUtilisateur() ? artiste.getGenreUtilisateur().getNomGenre() : 'N/A' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between mt-4">
            <button class="btn btn-secondary px-4" onclick="fermerModales()">Annuler</button>
            <button class="btn text-white px-4" style="background-color: #E58E82;" onclick="ouvrirModalConfirmation()">Sélectionner</button>
        </div>
    </div>
</div>

{# MODAL 2 : Confirmation #}
<div id="modalConfirmation" class="battle-modal" style="display:none;">
    <div class="battle-modal-content text-center">
        <input type="hidden" id="confirmEmailInvite">
        <input type="hidden" id="confirmPseudoInvite">

        <h3 class="fw-bold">Confirmer l'invitation</h3>
        <p class="mt-3">Voulez-vous inviter '<span id="nomArtisteConfirm" class="fw-bold" style="color: #E58E82;"></span>' ?</p>
        
        <div class="d-flex justify-content-around mt-4">
            <button class="btn btn-secondary px-4" onclick="fermerModales()">Annuler</button>
            {# Le bouton appelle maintenant la fonction JS définie ci-dessous #}
            <button class="btn text-white px-4" style="background-color: #E58E82;" onclick="envoyerInvitation()">Confirmer</button>
        </div>
    </div>
</div>

{# MODAL 3 : Succès #}
<div id="modalSucces" class="battle-modal" style="display:none;">
    <div class="battle-modal-content text-center">
        <h3 class="fw-bold">Invitation envoyée !</h3>
        <div class="d-grid gap-2 mt-4">
            <a href="?controller=album&method=afficherFormulaireAjout" class="btn text-white" style="background-color: #E58E82;">Gérer mes albums</a>
            <a href="?controller=home&method=afficher" class="btn text-white" style="background-color: #E58E82;">Aller aux Découvrir</a>
            <button class="btn text-white" style="background-color: #E58E82;" onclick="location.reload()">Retour aux Battles</button>
        </div>
    </div>
</div>

{# MODAL 4 : Choisir Chanson #}
<div id="modalChanson" class="battle-modal" style="display:none;">
    <div class="battle-modal-content">
        <h3 class="text-center fw-bold mb-3">Choisir une chanson</h3>
        <input type="hidden" id="idBattlePourChanson">
        <div class="list-group" style="max-height: 250px; overflow-y: auto;">
            {% for chanson in mesChansons %}
                <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" onclick="validerChanson('{{ chanson.getIdChanson() }}')">
                    {{ chanson.getTitreChanson() }} <i class="bi bi-music-note"></i>
                </button>
            {% else %}
                <p class="text-center text-muted">Aucune chanson. <a href="?controller=album&method=afficherFormulaireAjout">En ajouter ?</a></p>
            {% endfor %}
        </div>
        <div class="text-center mt-4"><button class="btn btn-secondary px-4" onclick="fermerModales()">Annuler</button></div>
    </div>
</div>

<style>
    .battle-modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 2000; }
    .battle-modal-content { background: #F2D1C9; padding: 30px; border-radius: 25px; width: 90%; max-width: 500px; border: 2px solid #E58E82; }
</style>

<script>
let artisteSel = { email: '', pseudo: '' };

function ouvrirModalSelection() { document.getElementById('modalSelection').style.display = 'flex'; }
function selectionnerArtiste(ligne, email, pseudo) {
    artisteSel = { email, pseudo };
    document.querySelectorAll('input[name="artisteRadio"]').forEach(r => r.checked = false);
    ligne.querySelector('input').checked = true;
}
function ouvrirModalConfirmation() {
    if (!artisteSel.email) return alert("Sélectionnez un artiste");
    document.getElementById('nomArtisteConfirm').innerText = artisteSel.pseudo;
    document.getElementById('modalSelection').style.display = 'none';
    document.getElementById('modalConfirmation').style.display = 'flex';
}
function envoyerInvitation() {
    const p = new URLSearchParams();
    p.append('emailInvite', artisteSel.email);
    p.append('pseudoInvite', artisteSel.pseudo);
    fetch('?controller=battle&method=inviter', { method: 'POST', body: p })
    .then(r => r.json()).then(() => {
        document.getElementById('modalConfirmation').style.display = 'none';
        document.getElementById('modalSucces').style.display = 'flex';
    });
}
function ouvrirModalChanson(id) {
    document.getElementById('idBattlePourChanson').value = id;
    document.getElementById('modalChanson').style.display = 'flex';
}
function validerChanson(idC) {
    const idB = document.getElementById('idBattlePourChanson').value;
    const p = new URLSearchParams();
    p.append('idBattle', idB);
    p.append('idChanson', idC);
    fetch('?controller=battle&method=choisirChanson', { method: 'POST', body: p })
    .then(r => r.json()).then(() => location.reload());
}
function fermerModales() { document.querySelectorAll('.battle-modal').forEach(m => m.style.display = 'none'); }
</script>