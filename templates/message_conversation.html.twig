{% extends "base_template.html.twig" %}
{% block header %}
    <link rel="stylesheet" href="{{ asset_version('/assets/css/chat.css') }}">
{% endblock %}
{% block content %}

<div class="chat-wrapper">
    <div class="chat-container">
        <div class="chat-header">
            <!-- Bouton de retour à la liste des conversations -->
            <a href="index.php?controller=message&method=lister" class="btn btn-sm btn-outline-secondary me-2">
                <i class="bi bi-arrow-left"></i>
            </a>
            <img src="{{ contact.urlPhotoUtilisateur is not empty ? contact.urlPhotoUtilisateur : 'https://placehold.co/160x160/e9b7a6/ffffff?text=' ~ contact.pseudoUtilisateur|first|upper }}" alt="{{ contact.pseudoUtilisateur }}">
            <h3>{{ contact.pseudoUtilisateur }}</h3>
        </div>

        <div class="chat-messages" id="chatMessages">
            {% for message in messages %}
                {% set estMonMessage = (message.emailExpediteur.emailUtilisateur != contact.emailUtilisateur) %}
                
                <div class="message-bubble {{ estMonMessage ? 'message-sent' : 'message-received' }}">
                    
                    {# --- LOGIQUE D'INVITATION BATTLE --- #}
                    {% if '[BATTLE_INVITE:' in message.contenu %}
                        {# Extraction de l'ID de la battle et du texte #}
                        {% set parts = message.contenu|split(':') %}
                        {% set idBattle = parts[1]|split(']')|first %}
                        {% set texteMessage = message.contenu|split(']')|last %}

                        <div class="battle-invite-box p-3 rounded-3 bg-white text-dark mb-2 shadow-sm border border-warning">
                            <p class="fw-bold mb-2 text-uppercase" style="color: #E58E82; font-size: 0.85rem;">
                                <i class="bi bi-trophy-fill"></i> Invitation Battle
                            </p>
                            <p class="small mb-3">{{ texteMessage }}</p>
                            
                            {% if not estMonMessage %}
                                {# L'invité voit les options Accepter / Refuser #}
                                <div class="d-flex gap-2">
                                    <a href="?controller=battle&method=accepter&idBattle={{ idBattle }}" class="btn btn-sm text-white flex-grow-1 fw-bold" style="background-color: #E58E82;">
                                        Accepter
                                    </a>
                                    <a href="?controller=battle&method=refuser&idBattle={{ idBattle }}" class="btn btn-sm btn-outline-secondary flex-grow-1 fw-bold" onclick="return confirm('Voulez-vous vraiment refuser cette battle ?')">
                                        Refuser
                                    </a>
                                </div>
                            {% else %}
                                {# L'expéditeur voit juste le statut #}
                                <div class="text-center p-1 rounded bg-light border small text-muted">
                                    Invitation envoyée
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        {# --- MESSAGE NORMAL --- #}
                        <div>{{ message.contenu }}</div>
                    {% endif %}

                    <div class="message-time">
                        {{ message.dateEnvoi|date('H:i') }}
                        {% if estMonMessage and message.estLu %}
                            <span style="margin-left: 6px; font-weight: bold; color: #ffebdf; font-size: 0.7rem;">✓ Vu</span>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <p style="text-align: center; color: #888;">Commencez la discussion avec {{ contact.pseudoUtilisateur }} !</p>
            {% endfor %}
        </div>

        <div class="chat-input-area">
            <form action="" method="POST" class="chat-input-form">
                <input type="text" name="contenu" class="chat-input" placeholder="Écrivez un message..." required autocomplete="off" maxlength="255" autofocus>
                <button type="submit" class="chat-send-btn">Envoyer</button>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const chatMessages = document.getElementById('chatMessages');
        
        function scrollToBottom() {
            if (chatMessages) {
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        }

        scrollToBottom();

        // Rafraîchissement automatique toutes les 3 secondes
        setInterval(() => {
            fetch(window.location.href)
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newMessagesBlock = doc.getElementById('chatMessages');
                    
                    if (newMessagesBlock && chatMessages.innerHTML !== newMessagesBlock.innerHTML) {
                        const isAtBottom = Math.abs((chatMessages.scrollHeight - chatMessages.scrollTop) - chatMessages.clientHeight) < 50;
                        chatMessages.innerHTML = newMessagesBlock.innerHTML;
                        if (isAtBottom) scrollToBottom();
                    }
                })
                .catch(error => console.error('Erreur de synchronisation :', error));
        }, 3000);
    });
</script>
{% endblock %}