{% extends "base_template.html.twig" %}

{% block header %}
	{{ parent() }}
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="{{ asset_version('/assets/css/dashboard.css') }}">
	<link rel="stylesheet" href="{{ asset_version('/assets/css/album_details.css') }}">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
{% endblock %}

{% block content %}
	{% set totalDuration = 0 %}
	{% for chanson in chansons %}
		{% set totalDuration = totalDuration + chanson.getDureeChanson() %}
	{% endfor %}
	{% set totalMinutes = (totalDuration / 60)|round(0, 'floor') %}
	{% set totalSeconds = totalDuration % 60 %}
	{% set totalSecondsPadded = '%02d'|format(totalSeconds) %}

	<main class="container-xl py-5 paaxio-dashboard paaxio-album-details">
		<div class="main-content-container bg-white">
			<div class="container-fluid pt-4 pb-2">
				<section class="paaxio-album-details__hero p-3 p-lg-5">

			<div class="d-flex flex-column flex-md-row align-items-start gap-4">
				<div class="flex-shrink-0">
					<img id="album-cover" src="{{ album.getUrlPochetteAlbum() ?: 'https://placehold.co/160x160/7b4343/ffffff?text=' ~ (album.getTitreAlbum()|replace({' ': '+'})|slice(0, 20)) }}" alt="Couverture de l'album {{ album.getTitreAlbum() }}" class="paaxio-album-details__cover">
				</div>

				<div class="flex-grow-1">
					<span class="text-sm fw-light text-uppercase paaxio-album-details__kicker">Album</span>
					<h2 class="display-4 fw-bolder mt-1 mb-2 paaxio-album-details__title" id="album-title">{{ album.getTitreAlbum() }}</h2>
					<p class="fs-5 fw-light paaxio-album-details__meta" id="album-meta">
						{% if album.getPseudoArtiste() %}
							<a href="/?controller=utilisateur&method=afficherProfilArtiste&pseudo={{ album.getPseudoArtiste()|e('url') }}">{{ album.getPseudoArtiste() }}</a>
						{% else %}
							{{ album.getArtisteAlbum() }}
						{% endif %}
						{% if album.getDateSortieAlbum() %}
							·
							{{ album.getDateSortieAlbum()|date('Y') }}
						{% endif %}
						·
						{{ chansons|length }}
						titre{{ chansons|length > 1 ? 's' : '' }},
						{{ totalMinutes }}
						min
						{{ totalSecondsPadded }}
						s
					</p>

					<!-- Lecteur Audio/Contrôles -->
					<div
						class="mt-4 pt-4 border-top border-light border-opacity-50">

						<!-- Titre de la piste en cours -->
						<p class="fs-6 fw-bold mb-2" id="current-track-title">Piste en cours : Aucune</p>

						<!-- Barre de Progression -->
						<div id="progress-bar-container" class="progress-bar-container rounded-pill">
							<div id="progress-bar" class="progress-bar rounded-pill w-0"></div>
						</div>

						<!-- Temps Écoulé / Durée Totale -->
						<div class="d-flex justify-content-between text-xs mt-1" style="opacity: 0.8;">
							<span id="current-time">0:00</span>
							<span id="duration">0:00</span>
						</div>

						<!-- Boutons de Contrôle -->
						<div class="mt-3 d-flex gap-3 align-items-center">
							<button id="play-pause-btn" type="button" onclick="playSelected()" class="btn btn-light text-dark rounded-circle shadow-sm" style="width: 48px; height: 48px;">
								<i id="play-pause-icon" class="bi bi-play-fill" style="font-size: 1.5rem; line-height: 1;"></i>
							</button>

							<!-- NOUVEAU: Bouton Aléatoire (Shuffle) -->
							<button type="button" class="btn btn-link p-0" title="Aléatoire">
								<i class="bi bi-shuffle" style="font-size: 1.8rem; color: rgba(255, 255, 255, 0.9);"></i>
							</button>

							<!-- Bouton "Aimer l'album" agrandi -->
							<button type="button" class="btn btn-link p-0" title="Aimer l'album">
								<i class="bi bi-heart-fill" style="font-size: 1.8rem; color: rgba(255, 255, 255, 0.9);"></i>
							</button>

							<!-- NOUVEAU: Contrôle du volume -->
							<div class="d-flex align-items-center ms-auto gap-2">
								<button id="volume-btn" type="button" class="btn btn-link p-0">
									<i id="volume-icon" class="bi bi-volume-up-fill" style="font-size: 1.8rem; color: rgba(255, 255, 255, 0.9);"></i>
								</button>
								<input type="range" id="volume-slider" min="0" max="100" value="75" class="align-self-center">
							</div>

						</div>
					</div>
					<!-- Fin Lecteur Audio/Contrôles -->
				</div>
			</div>

			</section>

			<div class="mt-4 paaxio-album-details__tableWrap">
				<table id="track-table" class="table table-hover align-middle paaxio-album-details__table">
					<thead class="paaxio-album-details__thead">
						<tr class="text-sm text-uppercase fw-semibold">
							<th scope="col" class="py-3 px-4" style="width: 5%;">#</th>
							<th scope="col" class="py-3 px-4" style="width: 55%;">Titre</th>
							<th scope="col" class="py-3 px-4 d-none d-sm-table-cell" style="width: 20%;">Nombre d'écoutes</th>
							<th scope="col" class="py-3 px-4" style="width: 10%;">Durée</th>
							<th scope="col" class="py-3 px-4" style="width: 10%;"></th>
						</tr>
					</thead>
					<tbody>
						{% if chansons is not empty %}
							{% for chanson in chansons %}
								<tr class="track-row paaxio-album-details__row{% if chansonSelected and chanson.getIdChanson() == chansonSelected %} selected-track{% endif %}" data-index="{{ loop.index0 }}" data-song-id="{{ chanson.getIdChanson() }}">
									<td class="py-3 px-4 fw-bold track-index">
										<span class="track-index-number">{{ loop.index }}</span>
										<span class="track-index-play" data-index="{{ loop.index0 }}" onclick="event.stopPropagation(); loadTrack({{ loop.index0 }})">
											<i class="bi bi-play-fill track-play-icon paaxio-album-details__iconBtn" style="font-size: 1rem;"></i>
										</span>
									</td>
									<td class="py-3 px-4 track-title">{{ chanson.getTitreChanson() }}</td>
									<td class="py-3 px-4 d-none d-sm-table-cell track-listens">{{ chanson.getNbEcouteChanson() ?? 0 }}</td>
									<td class="py-3 px-4 track-duration">{{ (chanson.getDureeChanson() / 60)|round(0, 'floor') }}:{{ '%02d'|format(chanson.getDureeChanson() % 60) }}</td>
								<td class="py-3 px-4 text-center d-flex align-items-center justify-content-center gap-1">
									<button title="Aimer la musique" class="btn btn-sm btn-link p-1 like-btn" data-id="{{ chanson.getIdChanson() }}">
										<i class="bi {% if chanson.getIsLiked() %}bi-heart-fill{% else %}bi-heart paaxio-album-details__iconBtn{% endif %}" style="font-size: 1rem;{% if chanson.getIsLiked() %} color: #2A9D8F;{% endif %}"></i>
									</button>
									{% if session is defined and session.user_logged_in is defined %}
										{% set existingIds = chansonPlaylistMap[chanson.getIdChanson()] ?? [] %}
										{% set availablePlaylists = [] %}
										{% if playlists is defined %}
											{% for playlist in playlists %}
												{% if playlist.getIdPlaylist() not in existingIds %}
													{% set availablePlaylists = availablePlaylists|merge([playlist]) %}
												{% endif %}
											{% endfor %}
										{% endif %}
										<div class="dropdown add-to-playlist-dropdown">
											<button class="btn btn-sm btn-link p-1 paaxio-album-details__iconBtn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Ajouter à une playlist" onclick="event.stopPropagation()">
												<i class="bi bi-plus-circle" style="font-size: 1rem;"></i>
											</button>
											<ul class="dropdown-menu dropdown-menu-end">
												<li><h6 class="dropdown-header">Ajouter à une playlist</h6></li>
												{% for playlist in availablePlaylists %}
													<li>
														<a class="dropdown-item add-to-playlist-item" href="#" data-chanson-id="{{ chanson.getIdChanson() }}" data-playlist-id="{{ playlist.getIdPlaylist() }}">
															{{ playlist.getNomPlaylist() }}
														</a>
													</li>
												{% endfor %}
												<li><hr class="dropdown-divider"></li>
												<li>
													<a class="dropdown-item create-playlist-from-song" href="#" data-chanson-id="{{ chanson.getIdChanson() }}">
														<i class="bi bi-plus-lg me-1"></i> Nouvelle playlist
													</a>
												</li>
											</ul>
										</div>
									{% endif %}
								</td>
								</tr>
							{% endfor %}
						{% else %}
							<tr>
								<td colspan="5" class="text-center py-4 text-muted">Cet album ne contient aucune chanson pour le moment.</td>
							</tr>
						{% endif %}
					</tbody>
				</table>
			</div>
			</div>
		</div>
	</main>

	<!-- L'élément audio réel (invisible) -->
	<audio id="audio-player"></audio>

	<!-- Toast container -->
	<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
		<div id="playlist-toast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
			<div class="d-flex">
				<div class="toast-body" id="playlist-toast-body"></div>
				<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fermer"></button>
			</div>
		</div>
	</div>

	<!-- Modal créer une playlist -->
	<div class="modal fade" id="createPlaylistModal" tabindex="-1" aria-labelledby="createPlaylistModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="createPlaylistModalLabel">Nouvelle playlist</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
				</div>
				<div class="modal-body">
					<input type="hidden" id="createPlaylistChansonId" value="">
					<div class="mb-3">
						<label for="newPlaylistName" class="form-label">Nom de la playlist</label>
						<input type="text" class="form-control" id="newPlaylistName" placeholder="Ma playlist" maxlength="255" required>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
					<button type="button" class="btn btn-primary" id="createPlaylistSubmit">Créer</button>
				</div>
			</div>
		</div>
	</div>

{% endblock %}

{% block script %}
	{{ parent() }}
	<script src="{{ asset_version('/assets/js/like-handler.js') }}"></script>
	<script>
		const audioPlayer = document.getElementById('audio-player');
const playPauseIcon = document.getElementById('play-pause-icon');
const progressBar = document.getElementById('progress-bar');
const progressBarContainer = document.getElementById('progress-bar-container');
const currentTimeEl = document.getElementById('current-time');
const durationEl = document.getElementById('duration');
const currentTrackTitleEl = document.getElementById('current-track-title');
const trackRows = document.querySelectorAll('.track-row');
const albumCover = document.getElementById('album-cover');
const volumeSlider = document.getElementById('volume-slider');
const volumeIcon = document.getElementById('volume-icon');

let currentTrackIndex = -1;
let isScrubbing = false;
let isDragging = false;
let wasPlayingBeforeScrub = false;

let isPlaying = false;

// CSRF token removed

// 1. CRÉATION DYNAMIQUE DE LA PLAYLIST À PARTIR DES DONNÉES TWIG
const playlist = [];{% for chanson in chansons %}playlist.push({id: {{ chanson.getIdChanson() }}, title: "{{ chanson.getTitreChanson()|e('js') }}", src: "{{ chanson.geturlAudioChanson()|default('https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3')|e('js') }}", durationFormatted: "{{ (chanson.getDureeChanson() / 60)|round(0, 'floor') }}:{{ '%02d'|format(chanson.getDureeChanson() % 60) }}"});{% endfor %}

// Suivi des chansons ayant atteint 75% de lecture (pour éviter les faux clics)
const playedBeyond75 = new Set();

// ID de la chanson sélectionnée depuis l'URL (si fourni)
const selectedSongId = {{ chansonSelected ?? 'null' }};

/**
         * Convertit un nombre de secondes en format MM:SS
         */
function formatTime(seconds) {
const minutes = Math.floor(seconds / 60);
const remainingSeconds = Math.floor(seconds % 60);
return `${minutes}:${
remainingSeconds < 10 ? '0' : ''
}${remainingSeconds}`;
}

/**
         * Met à jour l'affichage de la barre de progression et des temps.
         */
function updateProgress() {
if (audioPlayer.duration && ! isScrubbing) {
const progressPercent = (audioPlayer.currentTime / audioPlayer.duration) * 100;
progressBar.style.width = `${progressPercent}%`;
currentTimeEl.textContent = formatTime(audioPlayer.currentTime);
}
}

/**
         * Gère le déplacement (clic ou glisser) sur la barre de progression.
         */
function handleScrubbing(event) {
if (! audioPlayer.src) 
return;



const rect = progressBarContainer.getBoundingClientRect();
const offsetX = event.clientX - rect.left;
const width = progressBarContainer.offsetWidth;
const newTimeFraction = Math.max(0, Math.min(1, offsetX / width));

if (audioPlayer.duration) {
const newTime = newTimeFraction * audioPlayer.duration;
audioPlayer.currentTime = newTime;
progressBar.style.width = `${
newTimeFraction * 100
}%`;
currentTimeEl.textContent = formatTime(newTime);
}
}

/**
         * Gère la lecture et la pause de l'audio.
         */
window.playPause = function () {
if (currentTrackIndex === -1 && playlist.length > 0) {
loadTrack(0);
return;
}
if (isPlaying) {
audioPlayer.pause();
} else {
audioPlayer.play().catch(e => console.error("Erreur de lecture : ", e));
}
}

progressBarContainer.addEventListener('mousedown', (e) => {
if (! audioPlayer.src) 
return;



isScrubbing = true;
wasPlayingBeforeScrub = isPlaying;
if (wasPlayingBeforeScrub) {
audioPlayer.pause();
}
handleScrubbing(e);
});

document.addEventListener('mousemove', (e) => {
if (isScrubbing) {
e.preventDefault(); // Empêche la sélection de texte pendant le drag
handleScrubbing(e);
}
});

document.addEventListener('mouseup', () => {
if (isScrubbing) {
// Si la musique jouait avant le début du scrubbing (clic ou glisser),
// on la relance depuis la nouvelle position.
if (wasPlayingBeforeScrub) {
audioPlayer.play().catch(e => console.error("Erreur de lecture post-scrubbing : ", e));
}
// Si la musique était en pause, elle le reste à la nouvelle position,
// ce qui est le comportement attendu.
isScrubbing = false;
}
});

/**
         * Gère la lecture et la pause de l'audio.
         */
window.playPause = function () {
if (currentTrackIndex === -1 && playlist.length > 0) { // Si aucune piste n'est sélectionnée, lance la première
loadTrack(0);
return; // loadTrack va appeler play()
}

if (isPlaying) {
audioPlayer.pause();
playPauseIcon.classList.replace('bi-pause-fill', 'bi-play-fill');
} else {
audioPlayer.play().catch(e => console.error("Erreur de lecture : ", e));
playPauseIcon.classList.replace('bi-play-fill', 'bi-pause-fill');
} isPlaying = ! isPlaying;
updateTrackRowVisuals();
}

// Joue la piste sélectionnée dans la table (comportement identique à un double-clic)
window.playSelected = function () {
	const selectedRow = document.querySelector('.track-row.selected-track') || document.querySelector('.track-row.active-track');
	let index = -1;
	if (selectedRow) {
		index = parseInt(selectedRow.dataset.index, 10);
	}

	if (isNaN(index) || index < 0) {
		if (currentTrackIndex === -1 && playlist.length > 0) {
			loadTrack(0);
		} else {
			playPause();
		}
		return;
	}

	if (index === currentTrackIndex) {
		playPause();
	} else {
		loadTrack(index);
	}
}

/**
         * Charge une piste spécifique de la playlist et démarre la lecture.
         * @param {number} index - L'index de la piste à charger.
         */
window.loadTrack = function (index) {
if (index < 0 || index >= playlist.length) {
console.error("Index de piste invalide.");
return;
}

const track = playlist[index];

// Autoriser la ré-incrémentation de la même piste sur des lectures séparées
playedBeyond75.delete(track.id);

// Si c'est la même piste et qu'elle est en pause, on la relance
if (index === currentTrackIndex && ! isPlaying) {
audioPlayer.play().catch(e => console.error("Erreur de lecture : ", e));
isPlaying = true;
playPauseIcon.classList.replace('bi-play-fill', 'bi-pause-fill');
updateTrackRowVisuals();
return;
}

// Si c'est une nouvelle piste, on la charge et la joue
currentTrackIndex = index;
audioPlayer.src = track.src;
currentTrackTitleEl.textContent = `Piste en cours : ${
index + 1
}. ${
track.title
}`;
durationEl.textContent = track.durationFormatted;

// Joue la piste immédiatement après le chargement
audioPlayer.play().catch(e => {
console.error("Lecture automatique bloquée. Veuillez interagir.", e);
isPlaying = false;
playPauseIcon.classList.replace('bi-pause-fill', 'bi-play-fill');
});
isPlaying = true;
playPauseIcon.classList.replace('bi-play-fill', 'bi-pause-fill');

updateTrackRowVisuals();
}

/**
         * Met à jour les classes visuelles des lignes de la table pour l'état actif/en cours de lecture.
         */
function updateTrackRowVisuals() {
trackRows.forEach((row, index) => {
const playIcon = row.querySelector('.track-play-icon');

// 1. Gestion de la classe 'active-track'
if (index === currentTrackIndex) {
row.classList.add('active-track');
} else {
row.classList.remove('active-track');
}

// 2. Gestion de l'icône de lecture/pause dans la table
if (index === currentTrackIndex && isPlaying) {
playIcon.classList.replace('bi-play-fill', 'bi-pause-fill');
} else {
playIcon.classList.replace('bi-play-fill', 'bi-play-fill');
}
});
}


// --- Événements Audio ---

// NOUVEAU: Gère la rotation de la pochette
audioPlayer.addEventListener('play', () => {
albumCover.classList.add('rotating');
});

audioPlayer.addEventListener('pause', () => {
albumCover.classList.remove('rotating');
});


// Quand les métadonnées sont chargées (pour obtenir la durée réelle du fichier)
audioPlayer.addEventListener('loadedmetadata', () => { // Met à jour la durée totale avec la valeur réelle si elle est disponible
if (audioPlayer.duration && !isNaN(audioPlayer.duration)) {
durationEl.textContent = formatTime(audioPlayer.duration);
}
});

// Incrément d'écoute uniquement après 75% de la chanson jouée
audioPlayer.addEventListener('timeupdate', () => {
if (currentTrackIndex >= 0 && audioPlayer.duration) {
const track = playlist[currentTrackIndex];
const threshold75 = audioPlayer.duration * 0.75;

// Si on dépasse 75% et qu'on n'a pas déjà compté cette écoute
if (audioPlayer.currentTime >= threshold75 && !playedBeyond75.has(track.id)) {
playedBeyond75.add(track.id);

// Incrémente le compteur d'écoutes côté serveur
fetch('/?controller=chanson&method=incrementEcoute', {
	method: 'POST',
	headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
	body: 'idChanson=' + encodeURIComponent(track.id)
})
.then(res => res.json())
.then(data => {
    if (data && data.nbEcoute !== undefined) {
        // Met à jour l'affichage du nombre d'écoutes dans la table
        const row = document.querySelector('.track-row[data-index="' + currentTrackIndex + '"]');
        if (row) {
            const listensCell = row.querySelector('.track-listens');
            if (listensCell) listensCell.textContent = data.nbEcoute;
        }
    }
})
.catch(err => console.error('Erreur incrément écoute:', err));
}
}

// Mise à jour de la barre de progression
updateProgress();
});

// Quand la piste se termine, passe à la suivante
audioPlayer.addEventListener('ended', () => {
if (currentTrackIndex < playlist.length - 1) {
loadTrack(currentTrackIndex + 1);
} else { // Arrête la lecture à la fin de la playlist
isPlaying = false;
playPauseIcon.classList.replace('bi-pause-fill', 'bi-play-fill');
audioPlayer.currentTime = 0;
progressBar.style.width = '0%';
currentTimeEl.textContent = '0:00';
currentTrackTitleEl.textContent = `Piste en cours : Aucune`;
updateTrackRowVisuals();
}
});

// Gestion des erreurs
audioPlayer.addEventListener('error', (e) => {
console.error("Erreur de l'élément audio:", audioPlayer.error, e);
currentTrackTitleEl.textContent = "Erreur de chargement de la piste.";
isPlaying = false;
playPauseIcon.classList.replace('bi-pause-fill', 'bi-play-fill');
updateTrackRowVisuals();
});

// --- Initialisation ---
window.onload = function () { // Rend les lignes de la table cliquables (alternative au bouton)
trackRows.forEach((row) => {
const index = parseInt(row.dataset.index);
row.addEventListener('click', (e) => { // S'assurer que le clic n'est pas sur un bouton à l'intérieur
if (!e.target.closest('button')) {
loadTrack(index);
}
});
});

// Si une chanson est sélectionnée via l'URL, la charger et la mettre en évidence
if (selectedSongId !== null && playlist.length > 0) {
const selectedIndex = playlist.findIndex(track => track.id === selectedSongId);
if (selectedIndex !== -1) { // Trouver la ligne correspondante et la faire défiler en vue
const selectedRow = document.querySelector (`tr[data-song-id="${selectedSongId}"]`);
if (selectedRow) { // Faire défiler la ligne sélectionnée en vue avec un léger décalage
setTimeout(() => {
selectedRow.scrollIntoView({behavior: 'smooth', block: 'center'});
}, 100);
}
// Charger la piste sélectionnée (mais ne pas la jouer automatiquement)
currentTrackIndex = selectedIndex;
const track = playlist[selectedIndex];
audioPlayer.src = track.src;
currentTrackTitleEl.textContent = `Piste en cours : ${
currentTrackIndex + 1
}. ${
track.title
}`;
durationEl.textContent = track.durationFormatted;
updateTrackRowVisuals();
} else { // Si la chanson sélectionnée n'est pas trouvée, charger la première par défaut
if (playlist.length > 0) {
currentTrackIndex = 0;
const track = playlist[0];
audioPlayer.src = track.src;
currentTrackTitleEl.textContent = `Piste en cours : ${
currentTrackIndex + 1
}. ${
track.title
}`;
durationEl.textContent = track.durationFormatted;
updateTrackRowVisuals();
}
}
} else { // Charge la première piste par défaut si la playlist n'est pas vide
if (playlist.length > 0) {
currentTrackIndex = 0;
const track = playlist[0];
audioPlayer.src = track.src;
currentTrackTitleEl.textContent = `Piste en cours : ${
currentTrackIndex + 1
}. ${
track.title
}`;
durationEl.textContent = track.durationFormatted;
// L'état initial est toujours en pause, l'utilisateur doit cliquer sur play.
updateTrackRowVisuals();
}
}
};

// --- Gestion du Volume ---

function handleVolumeChange() {
const volume = volumeSlider.value / 100;
audioPlayer.volume = volume;
audioPlayer.muted = (volume === 0);

if (audioPlayer.muted || volume === 0) {
volumeIcon.classList.replace('bi-volume-up-fill', 'bi-volume-mute-fill');
volumeIcon.classList.replace('bi-volume-down-fill', 'bi-volume-mute-fill');
} else if (volume > 0.5) {
volumeIcon.classList.replace('bi-volume-mute-fill', 'bi-volume-up-fill');
volumeIcon.classList.replace('bi-volume-down-fill', 'bi-volume-up-fill');
} else {
volumeIcon.classList.replace('bi-volume-mute-fill', 'bi-volume-down-fill');
volumeIcon.classList.replace('bi-volume-up-fill', 'bi-volume-down-fill');
}
}

volumeSlider.addEventListener('input', handleVolumeChange);

document.getElementById('volume-btn').addEventListener('click', () => {
audioPlayer.muted = ! audioPlayer.muted;
if (audioPlayer.muted) {
volumeSlider.value = 0;
} else { // Rétablit le volume à 75% si on réactive le son depuis un état muet complet
volumeSlider.value = audioPlayer.volume > 0 ? audioPlayer.volume * 100 : 75;
} handleVolumeChange();
});

// Initialisation du volume au chargement de la page
handleVolumeChange();

// --- Gestion des Likes ---

// Délégation d'événements pour les boutons like (robuste et fonctionne pour éléments dynamiques)
document.addEventListener('click', function(e) {
    const btn = e.target.closest('.like-btn');
    if (!btn) return;

    e.stopPropagation(); // évite de déclencher le clic sur la ligne
    const chansonId = btn.dataset.id;
    const row = btn.closest('tr'); // récupère la ligne de la table
    const icon = btn.querySelector('i');

    fetch('/?controller=chanson&method=toggleLike', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `idChanson=${encodeURIComponent(chansonId)}`
    })
    .then(async (res) => {
        const text = await res.text();
        try {
            const data = JSON.parse(text);
            return { ok: res.ok, status: res.status, data };
        } catch (err) {
            console.error('Réponse non JSON du serveur pour toggleLike:', text);
            throw new Error('Réponse non JSON du serveur');
        }
    })
    .then(({ ok, status, data }) => {
        console.log('toggleLike response', status, data);
        if (data.liked) {
            // coeur rempli + rouge
            icon.classList.remove('bi-heart');
            icon.classList.add('bi-heart-fill');
            icon.style.color = '#2A9D8F';
        } else {
            // coeur vide + supprime rouge
            icon.classList.remove('bi-heart-fill');
            icon.classList.add('bi-heart');
            icon.style.color = '';

            // Supprime la ligne uniquement si on est sur la page des musiques likées
            if (window.location.search.includes('controller=utilisateur') && window.location.search.includes('method=afficherMesLikes')) {
                if (row) row.remove();

                // Supprime la chanson de la playlist JS
                const indexInPlaylist = playlist.findIndex(track => track.id == chansonId);
                if (indexInPlaylist !== -1) {
                    playlist.splice(indexInPlaylist, 1);

                    // Si la chanson supprimée est la piste en cours, jouer la suivante
                    if (currentTrackIndex === indexInPlaylist) {
                        if (playlist.length > 0) {
                            const nextIndex = Math.min(indexInPlaylist, playlist.length - 1);
                            loadTrack(nextIndex);
                        } else {
                            // Plus de pistes → arrêt
                            audioPlayer.pause();
                            audioPlayer.currentTime = 0;
                            progressBar.style.width = '0%';
                            currentTimeEl.textContent = '0:00';
                            currentTrackTitleEl.textContent = `Piste en cours : Aucune`;
                            currentTrackIndex = -1;
                            isPlaying = false;
                            playPauseIcon.classList.replace('bi-pause-fill', 'bi-play-fill');
                        }
                    } else if (currentTrackIndex > indexInPlaylist) {
                        // Ajuste l'index de la piste en cours si une piste avant elle a été supprimée
                        currentTrackIndex--;
                    }
                }
            }
        }
    })
    .catch(err => {
        console.error('Erreur like:', err);
        // Affiche une erreur visuelle minimale pour l'utilisateur
        if (icon) icon.classList.add('text-muted');
    });
    });

// --- Toast helper ---
function showPlaylistToast(message, success) {
    const toastEl = document.getElementById('playlist-toast');
    const toastBody = document.getElementById('playlist-toast-body');
    toastBody.textContent = message;
    toastEl.className = 'toast align-items-center border-0 text-white ' + (success ? 'bg-success' : 'bg-danger');
    const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
    toast.show();
}

// --- Ajout à une playlist ---
document.querySelectorAll('.add-to-playlist-item').forEach(function(item) {
    item.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        const idChanson = item.dataset.chansonId;
        const idPlaylist = item.dataset.playlistId;
        const playlistName = item.textContent.trim();
        const dropdown = item.closest('.add-to-playlist-dropdown');

        fetch('/?controller=playlist&method=ajouterChanson', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `idChanson=${encodeURIComponent(idChanson)}&idPlaylist=${encodeURIComponent(idPlaylist)}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showPlaylistToast(`Ajouté à « ${playlistName} »`, true);

                const li = item.closest('li');
                if (li) li.remove();
            } else {
                showPlaylistToast(data.message || 'Erreur lors de l\'ajout', false);
            }
        })
        .catch(err => {
            console.error('Erreur ajout playlist:', err);
            showPlaylistToast('Erreur réseau', false);
        });
    });
});

// --- Créer une playlist depuis le dropdown ---
document.querySelectorAll('.create-playlist-from-song').forEach(function(link) {
    link.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        document.getElementById('createPlaylistChansonId').value = link.dataset.chansonId;
        document.getElementById('newPlaylistName').value = '';
        document.getElementById('newPlaylistName').classList.remove('is-invalid');
        new bootstrap.Modal(document.getElementById('createPlaylistModal')).show();
    });
});

(function() {
    const createModal = document.getElementById('createPlaylistModal');
    const nameInput = document.getElementById('newPlaylistName');
    const submitBtn = document.getElementById('createPlaylistSubmit');
    const chansonIdInput = document.getElementById('createPlaylistChansonId');

    if (!createModal) return;

    createModal.addEventListener('shown.bs.modal', () => nameInput.focus());

    nameInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); submitBtn.click(); }
    });

    submitBtn.addEventListener('click', () => {
        const nom = nameInput.value.trim();
        if (!nom) { nameInput.classList.add('is-invalid'); return; }
        nameInput.classList.remove('is-invalid');
        submitBtn.disabled = true;

        const chansonId = chansonIdInput.value;

        fetch('/?controller=playlist&method=creerPlaylist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `nomPlaylist=${encodeURIComponent(nom)}`
        })
        .then(res => res.json())
        .then(data => {
            if (!data.success) {
                submitBtn.disabled = false;
                showPlaylistToast(data.message || 'Erreur', false);
                return;
            }

            if (chansonId) {
                return fetch('/?controller=playlist&method=ajouterChanson', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `idChanson=${encodeURIComponent(chansonId)}&idPlaylist=${encodeURIComponent(data.idPlaylist)}`
                })
                .then(r => r.json())
                .then(addData => {
                    submitBtn.disabled = false;
                    bootstrap.Modal.getInstance(createModal).hide();
                    nameInput.value = '';
                    chansonIdInput.value = '';
                    if (addData.success) {
                        showPlaylistToast(`Ajouté à la nouvelle playlist « ${data.nomPlaylist} »`, true);
                    } else {
                        showPlaylistToast(`Playlist créée, mais : ${addData.message}`, false);
                    }
                });
            } else {
                submitBtn.disabled = false;
                bootstrap.Modal.getInstance(createModal).hide();
                nameInput.value = '';
                showPlaylistToast(`Playlist « ${data.nomPlaylist} » créée`, true);
            }
        })
        .catch(err => {
            submitBtn.disabled = false;
            console.error('Erreur création playlist:', err);
            showPlaylistToast('Erreur réseau', false);
        });
    });
})();
	</script>
