{% extends "base_template.html.twig" %}

{% block content %}
<div class="chat-wrapper">
    <div class="chat-container">
        <div class="chat-header">
            <h3>Mes Conversations</h3>
        </div>

        <div class="contact-list">
            {# On boucle maintenant sur 'item' qui contient item.user et item.aNonLu #}
            {% for item in contacts %}
                <a href="?controller=message&method=conversation&contact={{ item.user.pseudoUtilisateur }}" class="contact-item">
                    
                    <div style="position: relative;">
                        <img src="{{ item.user.urlPhotoUtilisateur ?? '/assets/images/default-avatar.png' }}" alt="{{ item.user.pseudoUtilisateur }}" class="contact-avatar">
                        
                        {# 🚨 L'indicateur visuel si le message n'est pas lu #}
                        {% if item.aNonLu %}
                            <span class="unread-badge"></span>
                        {% endif %}
                    </div>
                    
                    <div class="contact-info">
                        {# On peut même mettre le nom en gras si c'est non lu #}
                        <span class="contact-name" {% if item.aNonLu %}style="font-weight: 900; color: var(--paaxio-brand);"{% endif %}>
                            {{ item.user.pseudoUtilisateur }}
                        </span>
                    </div>
                    
                    <div class="contact-action">
                        <span>Discuter ➔</span>
                    </div>
                    
                </a>
            {% else %}
                <div class="chat-empty-state" style="padding: 40px;">
                    <p>Vous n'avez pas encore de conversation.</p>
                    <p>Allez sur le profil d'un artiste pour lui envoyer un premier message !</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // On cible la zone qui contient la liste des contacts
        const contactList = document.querySelector('.contact-list');
        
        if (contactList) {
            // On vérifie toutes les 3 secondes
            setInterval(() => {
                // On demande la page actuelle en arrière-plan
                fetch(window.location.href)
                    .then(response => response.text())
                    .then(html => {
                        // On transforme le texte en HTML
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        
                        // On récupère la NOUVELLE liste générée par le serveur
                        const newContactList = doc.querySelector('.contact-list');
                        
                        // Si la nouvelle liste est différente de l'actuelle, on met à jour l'affichage
                        if (newContactList && contactList.innerHTML !== newContactList.innerHTML) {
                            contactList.innerHTML = newContactList.innerHTML;
                        }
                    })
                    .catch(error => console.error('Erreur lors du rafraîchissement de la liste :', error));
            }, 3000); // 3000 ms = 3 secondes
        }
    });
</script>
{% endblock %}